rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Broad Read & Delete (Allows the app to fetch data and delete items normally)
    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. User Profile Validation
    match /users/{userId} {
      // Your JS sends the data nested inside a "profile" object
      allow create, update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.profile.name is string &&
                      request.resource.data.profile.email is string &&
                      request.resource.data.profile.budget is number;
    }
    
    // 3. Transactions Validation
    match /users/{userId}/transactions/{transactionId} {
      allow create, update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.type in ['income', 'expense'] &&
                      // Added income categories so it doesn't crash!
                      request.resource.data.category in ['food', 'study', 'hostel', 'travel', 'shopping', 'other', 'pocket_money', 'salary', 'freelance'] &&
                      // JS saves dates as ISO strings, not timestamps
                      request.resource.data.date is string;
    }
    
    // 4. Accounts Validation
    match /users/{userId}/accounts/{accountId} {
      allow create, update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0 &&
                      request.resource.data.type in ['savings', 'current', 'wallet'] &&
                      request.resource.data.balance is number;
                      // Removed >= 0 so you can have a negative balance if you overspend!
    }
    
    // 5. Budgets Validation
    match /users/{userId}/budgets/{budgetId} {
      allow create, update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.limit is number &&
                      request.resource.data.limit > 0 &&
                      request.resource.data.threshold is number &&
                      request.resource.data.threshold >= 0 &&
                      request.resource.data.threshold <= 100;
    }
    
    // 6. Deny all other access globally
    match /{document=**} {
      allow read, write: if false;
    }
  }
}